<!DOCTYPE html>
<html lang="en">
  <head>
    <script>(function(){try{var t=localStorage.getItem('axoniq-theme');if(t==='light'||t==='dark'){document.documentElement.setAttribute('data-theme',t);}}catch(e){}})();</script>
    {{> head defaultPageTitle='AxonIQ Docs'}}
  </head>
  <body class="article{{#with (or page.attributes.role page.role)}} {{{this}}}{{/with}}">
    <div class="header_container">
      {{> banner}}
    </div>
    <div class="content_container">
      {{> topbar}}
      {{> body}}
      {{> cmdk}}
      {{> footer}}
    </div>
  </body>
</html>
