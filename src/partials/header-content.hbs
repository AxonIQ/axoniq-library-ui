<header class="header">
  <nav class="navbar">
    <div class="navbar-brand">
      <a class="navbar-item" href="{{{or site.url siteRootPath}}}">
        <img src="{{uiRootPath}}/img/docs-logo.png" class="header_logo"/>
      </a>
      <button class="navbar-burger" data-target="topbar-nav">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
    <div id="topbar-nav" class="navbar-menu">
      <div class="navbar-center">
        <a class="navbar-item" href="{{relativize (resolveComponentReference site.components 'home' 'Basics')}}">Basics</a>
        <div class="navbar-item has-dropdown is-hoverable">
          <a class="navbar-link" href="{{relativize (resolveComponentReference site.components 'home' 'Guides')}}">Guides</a>
          <div class="navbar-dropdown">
            <a class="navbar-item" href="{{{relativize '/home/guides/axon-framework'}}}">Axon Framework</a>
            <a class="navbar-item" href="{{{relativize '/home/guides/axon-server'}}}">Axon Server</a>
          </div>
        </div>
        <div class="navbar-item has-dropdown is-hoverable">
          <a class="navbar-link" href="{{relativize (resolveComponentReference site.components 'home' 'Reference Guides')}}">Reference</a>
          <div class="navbar-dropdown">
            {{#each site.components }}
              {{#if (eq this.asciidoc.attributes.type 'reference')}}
                <a class="navbar-item" href="{{{relativize this.url}}}">{{this.title}}</a>
              {{/if}}
            {{/each}}
          </div>
        </div>
      </div>
      <div class="header-toolbar">
        <button type="button" class="cmdk-launch" id="cmdk-launch" aria-label="Search documentation">
          <svg class="cmdk-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/></svg>
          <span class="cmdk-placeholder">Search documentation…</span>
          <span class="cmdk-kbd">⌘K</span>
        </button>
        <button type="button" class="icon-btn theme-toggle" id="theme-toggle" aria-label="Toggle theme">
          <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        </button>
        <a class="navbar-item navbar-button" href="https://platform.axoniq.io" target="_blank" rel="noopener">AxonIQ Platform</a>
      </div>
    </div>
  </nav>
</header>
