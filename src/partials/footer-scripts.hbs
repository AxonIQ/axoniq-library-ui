<script id="site-script" src="{{{uiRootPath}}}/js/site.js" data-ui-root-path="{{{uiRootPath}}}"></script>
<script async src="{{{uiRootPath}}}/js/vendor/highlight.js"></script>
<script async src="{{{uiRootPath}}}/js/vendor/page-actions.js"></script>
<script async src="{{{uiRootPath}}}/js/vendor/tabs.js" data-sync-storage-key="preferred-tab" data-sync-storage-scope="session"></script>
{{!--
  Search: reuse the Lunr index generated by @antora/lunr-extension, but render
  results in our ⌘K palette (app.js defines window.antoraSearch.initSearch).
  We deliberately do NOT include the extension's {{> search-scripts}} partial,
  because its search-ui.js binds to a #search-input we no longer render.
  Order: lunr.js (defines lunr) → app.js (defines the hook, deferred) →
  search-index.js (deferred, calls the hook). Deferred scripts run in order.
--}}
<script src="{{{uiRootPath}}}/js/vendor/lunr.js"></script>
<script defer src="{{{uiRootPath}}}/js/vendor/app.js"></script>
<script defer src="{{{siteRootPath}}}/search-index.js"></script>
