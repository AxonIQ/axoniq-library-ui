<header class="topbar">
  <div class="topbar-left">
    {{> breadcrumbs}}
  </div>
  <div class="topbar-right">
    <button type="button" class="topbar-search" id="cmdk-launch" aria-label="Search documentation">
      <svg class="topbar-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/></svg>
      <span class="topbar-search-placeholder">Search documentation…</span>
      <span class="topbar-search-kbd">⌘K</span>
    </button>
    <button type="button" class="icon-btn theme-toggle" id="theme-toggle" aria-label="Toggle theme">
      <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
    </button>
    <a class="topbar-cta" href="https://platform.axoniq.io" target="_blank" rel="noopener">
      <span>Axoniq Platform</span>
      <svg class="topbar-cta-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><polyline points="8 7 17 7 17 16"/></svg>
    </a>
  </div>
</header>
