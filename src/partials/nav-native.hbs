{{!--
  Fallback drawer nav, used whenever the `nav-assembler` Antora extension
  (axoniq-library-site/lib/nav-assembler.js) hasn't run for this build — e.g.
  an individual repo's own local doc-verification playbook, which never
  registers it (only the aggregated axoniq-library-site build does; see
  helpers/navPartial.js).

  Renders the current page's own Antora navigation (page.navigation) directly
  — no cross-component curation — using the same markup contract the
  assembled drawer produces (.nav-section/.nav-tree/nav-group/data-href) so
  app.js and custom.css behave the same either way. page.navigation is a list
  of top-level MENUS (usually one untitled menu per nav.adoc), so it's
  flattened first via navNativeItems — see there.

  The section title is a <div role="heading" aria-level="3">, not a literal
  <h3>: it's drawer chrome (the component's own title), not real page
  content, so it shouldn't compete with the page's own headings in the
  document's native heading outline — but the ARIA role/level keeps it
  discoverable as a heading for assistive tech. Mirrors nav-assembler.js's
  sectionHtml().
--}}
{{#with (navNativeItems page.navigation)}}
{{#if length}}
<section class="nav-section">
  <div class="nav-section-title" role="heading" aria-level="3">{{#with @root.page.componentVersion}}{{title}}{{/with}}</div>
  <ul class="nav-tree">
    {{#each this}}
    {{> nav-native-item navPath=@index}}
    {{/each}}
  </ul>
</section>
{{/if}}
{{/with}}
